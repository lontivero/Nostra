<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    </PropertyGroup>

    <ItemGroup>
        <!-- Shared utilities -->
        <Compile Include="UICmd.fs" />

        <!-- Domain layer - pure business types -->
        <Compile Include="Domain\Domain.fs" />
        <Compile Include="Domain\CachedTypes.fs" />
        <Compile Include="Domain\ViewModels.fs" />

        <!-- Infrastructure layer - persistence, services, state -->
        <Compile Include="Infrastructure\Types.fs" />
        <Compile Include="Infrastructure\DomainStore.fs" />
        <Compile Include="Infrastructure\Cache.fs" />
        <Compile Include="Infrastructure\NostrService.fs" />

        <!-- Views layer - UI components -->
        <Compile Include="Views\Styles.fs" />
        <Compile Include="Views\Common.fs" />
        <Compile Include="Views\Connection.fs" />
        <Compile Include="Views\Feed.fs" />
        <Compile Include="Views\Navigation.fs" />
        <Compile Include="Views\Relays.fs" />
        <Compile Include="Views\Settings.fs" />
        <Compile Include="Views\Notifications.fs" />
        <Compile Include="Views\Bookmarks.fs" />
        <Compile Include="Views\Search.fs" />
        <Compile Include="Views\StatusBar.fs" />
        <Compile Include="Views\Home.fs" />

        <!-- Application composition -->
        <Compile Include="App.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Nostra\Nostra.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AsyncImageLoader.Avalonia" />
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.FuncUI" />
        <PackageReference Include="Avalonia.FuncUI.Elmish" />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="LiteDB" />
    </ItemGroup>

</Project>
