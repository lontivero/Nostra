<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="UICmd.fs" />
        <Compile Include="Types.fs" />
        <Compile Include="NostrService.fs" />
        <Compile Include="Styles.fs" />
        <Compile Include="Common.fs" />
        <Compile Include="Feed.fs" />
        <Compile Include="Navigation.fs" />
        <Compile Include="Relays.fs" />
        <Compile Include="Settings.fs" />
        <Compile Include="Notifications.fs" />
        <Compile Include="Bookmarks.fs" />
        <Compile Include="Search.fs" />
        <Compile Include="Home.fs" />
        <Compile Include="App.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Nostra\Nostra.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AsyncImageLoader.Avalonia" />
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.FuncUI" />
        <PackageReference Include="Avalonia.FuncUI.Elmish" />
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

</Project>